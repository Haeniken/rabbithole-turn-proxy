# Rabbit Hole TURN Proxy — пример переменных для docker-compose.yml.example.
# Скопируйте этот файл в .env и измените значения под свой сервер:
#   cp .env.example .env
# Рабочий .env исключён из Git. Не публикуйте WRAP_KEY и другие секреты.

# Локальный WireGuard- или TCP-backend, куда сервер передаёт трафик клиентов.
# Параметр обязателен. Не открывайте backend на публичном интерфейсе без нужды.
CONNECT_ADDR=127.0.0.1:51820

# Публичный адрес и UDP-порт стабильного TURN listener.
LISTEN_ADDR=0.0.0.0:56000

# HTTP endpoints /healthz, /readyz и /metrics. Оставляйте на loopback;
# публикация метрик наружу требует отдельной аутентификации или сетевого ACL.
METRICS_LISTEN=127.0.0.1:9090

# Имя стабильного экземпляра в метриках.
INSTANCE_NAME=stable

# Время мягкого завершения активных сессий после SIGTERM.
DRAIN_TIMEOUT=30s

# Мягкие пределы admission control. Ноль отключает соответствующую проверку.
MAX_SESSIONS=2048
MAX_HANDSHAKES=128
MAX_GOROUTINES=20000

# Число файловых дескрипторов, которое всегда резервируется от новых сессий.
MIN_FREE_FDS=128

# Режим TCP/VLESS. Для обычного WireGuard-over-TURN оставьте false.
VLESS_MODE=false
VLESS_BOND=false

# WRAP-обфускация. При WRAP_MODE=true у клиента и сервера должен быть одинаковый
# 64-символьный hex-ключ. Сгенерировать его можно командой:
#   docker run --rm --entrypoint ./vk-turn-proxy rabbithole-turn-proxy:local -gen-wrap-key
WRAP_MODE=false
WRAP_KEY=

# Подробные серверные логи. Включайте временно для диагностики.
DEBUG_MODE=false

# Профиль и MTU внутреннего KCP-транспорта: fast, balanced или slow.
# Значение 1200 безопасно для большинства мобильных и Wi-Fi сетей.
VK_TURN_KCP_PROFILE=balanced
VK_TURN_KCP_MTU=1200

# Отдельный canary слушает другой порт и имеет собственные endpoints метрик.
# Он запускается только с профилем: docker compose --profile canary up -d
CANARY_LISTEN_ADDR=0.0.0.0:56001
CANARY_METRICS_LISTEN=127.0.0.1:9091
CANARY_INSTANCE_NAME=canary
CANARY_MAX_SESSIONS=32
